{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://nkust.edu.tw/mislab/final/schema/inference-result.schema.json",
  "title": "DED Inference Result",
  "description": "Standard output contract for a DED heat-playback inference result at one playback point.",
  "type": "object",
  "required": [
    "schema_version",
    "inference_stage",
    "state",
    "cause",
    "confidence",
    "recommended_action",
    "recommended_parameter_change",
    "related_rule",
    "related_parameter",
    "evidence",
    "time_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "ded-inference-result-v1"
    },
    "inference_stage": {
      "type": "string",
      "description": "Current implementation stage, for example format_v1 or threshold_preview."
    },
    "state": {
      "type": "string",
      "enum": [
        "not_evaluated",
        "good",
        "warning",
        "abnormal",
        "unknown"
      ]
    },
    "state_label": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recommended_action": {
      "type": "string"
    },
    "recommended_parameter_change": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "parameter",
          "direction"
        ],
        "properties": {
          "parameter": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "maintain",
              "increase",
              "decrease",
              "inspect",
              "mark"
            ]
          },
          "magnitude": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "related_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_parameter": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "properties": {
        "g_high": {
          "type": [
            "number",
            "null"
          ]
        },
        "layer_index": {
          "type": [
            "number",
            "integer",
            "null"
          ]
        },
        "timestamp_ms": {
          "type": [
            "number",
            "null"
          ]
        },
        "x_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "y_mm": {
          "type": [
            "number",
            "null"
          ]
        },
        "z_mm": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "time_context": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "playback_progress": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "time_label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
