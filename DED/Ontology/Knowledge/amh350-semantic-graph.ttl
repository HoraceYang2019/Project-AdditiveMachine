@prefix ded: <http://nkust.edu.tw/mislab/ded/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ded:AMH350SemanticGraph rdf:type owl:Ontology ;
    rdfs:label "AMH-350 DED 成型資料流 ontology"@zh-tw ;
    rdfs:comment "參考 CNC-TMV-720 與 MachineCenter runtime ontology 的建模方式，描述 AMH-350、熱像儀、Edge、MPF/G-code、對齊視窗、品質判斷與儀表板顯示。"@zh-tw .

#################################################################
# Object properties
#################################################################

ded:hasSensor rdf:type owl:ObjectProperty ;
    rdfs:label "裝設感測器"@zh-tw ;
    rdfs:domain ded:Machine ;
    rdfs:range ded:Sensor .

ded:hasEdge rdf:type owl:ObjectProperty ;
    rdfs:label "連接 Edge 裝置"@zh-tw ;
    rdfs:domain ded:Machine ;
    rdfs:range ded:EdgeDevice .

ded:usesNCFile rdf:type owl:ObjectProperty ;
    rdfs:label "使用 MPF / G-code 檔案"@zh-tw ;
    rdfs:domain ded:Machine ;
    rdfs:range ded:NCFile .

ded:generatesSignal rdf:type owl:ObjectProperty ;
    rdfs:label "產生資料訊號"@zh-tw ;
    rdfs:domain ded:PhysicalAsset ;
    rdfs:range ded:Signal .

ded:belongsToWindow rdf:type owl:ObjectProperty ;
    rdfs:label "歸屬於同步視窗"@zh-tw ;
    rdfs:domain ded:Signal ;
    rdfs:range ded:MultiSensorWindow .

ded:alignedWithNCBlock rdf:type owl:ObjectProperty ;
    rdfs:label "對齊 NC 區塊"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range ded:NCBlock .

ded:alignedWithToolPathSegment rdf:type owl:ObjectProperty ;
    rdfs:label "對齊刀具路徑段"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range ded:ToolPathSegment .

ded:mapsToJSONField rdf:type owl:ObjectProperty ;
    rdfs:label "對應 JSON / CSV 欄位"@zh-tw ;
    rdfs:domain ded:Signal ;
    rdfs:range ded:JSONField .

ded:containsField rdf:type owl:ObjectProperty ;
    rdfs:label "包含資料欄位"@zh-tw ;
    rdfs:domain ded:CyberAsset ;
    rdfs:range ded:JSONField .

ded:usesKnowledge rdf:type owl:ObjectProperty ;
    rdfs:label "使用 Knowledge"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range ded:Knowledge .

ded:evaluatedByRule rdf:type owl:ObjectProperty ;
    rdfs:label "依規則判斷"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range ded:ThresholdRule .

ded:hasDiagnosis rdf:type owl:ObjectProperty ;
    rdfs:label "產生品質判斷"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range ded:Diagnosis .

ded:displayedBy rdf:type owl:ObjectProperty ;
    rdfs:label "顯示於儀表板"@zh-tw ;
    rdfs:domain ded:Entity ;
    rdfs:range ded:Dashboard .

#################################################################
# Datatype properties
#################################################################

ded:hasJSONKey rdf:type owl:DatatypeProperty ;
    rdfs:label "資料欄位名稱"@zh-tw ;
    rdfs:domain ded:JSONField ;
    rdfs:range xsd:string .

ded:hasTimestamp rdf:type owl:DatatypeProperty ;
    rdfs:label "時間戳記"@zh-tw ;
    rdfs:domain ded:Signal ;
    rdfs:range xsd:dateTime .

ded:hasStartTime rdf:type owl:DatatypeProperty ;
    rdfs:label "視窗起始時間"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range xsd:dateTime .

ded:hasEndTime rdf:type owl:DatatypeProperty ;
    rdfs:label "視窗結束時間"@zh-tw ;
    rdfs:domain ded:MultiSensorWindow ;
    rdfs:range xsd:dateTime .

ded:hasUnit rdf:type owl:DatatypeProperty ;
    rdfs:label "單位"@zh-tw ;
    rdfs:domain ded:Signal ;
    rdfs:range xsd:string .

ded:hasValue rdf:type owl:DatatypeProperty ;
    rdfs:label "量測值"@zh-tw ;
    rdfs:domain ded:Signal ;
    rdfs:range xsd:decimal .

ded:hasXMillimeter rdf:type owl:DatatypeProperty ;
    rdfs:label "X 座標 mm"@zh-tw ;
    rdfs:domain ded:EdgePositionSignal ;
    rdfs:range xsd:decimal .

ded:hasYMillimeter rdf:type owl:DatatypeProperty ;
    rdfs:label "Y 座標 mm"@zh-tw ;
    rdfs:domain ded:EdgePositionSignal ;
    rdfs:range xsd:decimal .

ded:hasZMillimeter rdf:type owl:DatatypeProperty ;
    rdfs:label "Z 座標 mm"@zh-tw ;
    rdfs:domain ded:EdgePositionSignal ;
    rdfs:range xsd:decimal .

ded:hasMinInclusive rdf:type owl:DatatypeProperty ;
    rdfs:label "最小值，包含"@zh-tw ;
    rdfs:domain ded:ThresholdRule ;
    rdfs:range xsd:decimal .

ded:hasMaxExclusive rdf:type owl:DatatypeProperty ;
    rdfs:label "最大值，不包含"@zh-tw ;
    rdfs:domain ded:ThresholdRule ;
    rdfs:range xsd:decimal .

ded:hasStateLabel rdf:type owl:DatatypeProperty ;
    rdfs:label "狀態名稱"@zh-tw ;
    rdfs:domain ded:ThresholdRule ;
    rdfs:range xsd:string .

ded:hasRuleExpression rdf:type owl:DatatypeProperty ;
    rdfs:label "規則表示式"@zh-tw ;
    rdfs:domain ded:Knowledge ;
    rdfs:range xsd:string .

ded:sourceFile rdf:type owl:DatatypeProperty ;
    rdfs:label "來源檔案"@zh-tw ;
    rdfs:domain ded:Entity ;
    rdfs:range xsd:string .

#################################################################
# Classes
#################################################################

ded:Entity rdf:type owl:Class ;
    rdfs:label "實體"@zh-tw .

ded:PhysicalAsset rdf:type owl:Class ;
    rdfs:subClassOf ded:Entity ;
    rdfs:label "硬體資產"@zh-tw .

ded:CyberAsset rdf:type owl:Class ;
    rdfs:subClassOf ded:Entity ;
    rdfs:label "數位資產"@zh-tw .

ded:Machine rdf:type owl:Class ;
    rdfs:subClassOf ded:PhysicalAsset ;
    rdfs:label "機台"@zh-tw .

ded:Sensor rdf:type owl:Class ;
    rdfs:subClassOf ded:PhysicalAsset ;
    rdfs:label "感測器"@zh-tw .

ded:ThermalCamera rdf:type owl:Class ;
    rdfs:subClassOf ded:Sensor ;
    rdfs:label "熱像儀"@zh-tw .

ded:EdgeDevice rdf:type owl:Class ;
    rdfs:subClassOf ded:PhysicalAsset ;
    rdfs:label "Edge 裝置"@zh-tw .

ded:Signal rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "感測資料訊號"@zh-tw .

ded:ThermalGHighSignal rdf:type owl:Class ;
    rdfs:subClassOf ded:Signal ;
    rdfs:label "熱像儀 G_High 溫度訊號"@zh-tw .

ded:EdgePositionSignal rdf:type owl:Class ;
    rdfs:subClassOf ded:Signal ;
    rdfs:label "Edge XYZ 座標訊號"@zh-tw .

ded:EdgeAlignmentErrorSignal rdf:type owl:Class ;
    rdfs:subClassOf ded:Signal ;
    rdfs:label "Edge 時間對齊誤差訊號"@zh-tw .

ded:MultiSensorWindow rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "多感測器同步視窗"@zh-tw .

ded:NCFile rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "MPF / G-code 檔案"@zh-tw .

ded:NCBlock rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "NC 程式區塊"@zh-tw .

ded:ToolPathSegment rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "刀具路徑段"@zh-tw .

ded:JSONField rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "CSV / JSON 欄位"@zh-tw .

ded:Knowledge rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "Knowledge / 判斷知識"@zh-tw .

ded:ThresholdRule rdf:type owl:Class ;
    rdfs:subClassOf ded:Knowledge ;
    rdfs:label "熱值門檻規則"@zh-tw .

ded:AlignmentKnowledge rdf:type owl:Class ;
    rdfs:subClassOf ded:Knowledge ;
    rdfs:label "對齊知識"@zh-tw .

ded:Diagnosis rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "品質判斷結果"@zh-tw .

ded:Dashboard rdf:type owl:Class ;
    rdfs:subClassOf ded:CyberAsset ;
    rdfs:label "儀表板顯示"@zh-tw .

#################################################################
# Physical assets
#################################################################

ded:Machine_AMH350 rdf:type owl:NamedIndividual ,
                           ded:Machine ;
    rdfs:label "機台：AMH-350"@zh-tw ;
    ded:hasSensor ded:ThermalCamera_AMH350 ;
    ded:hasEdge ded:Edge_AMH350 ;
    ded:usesNCFile ded:MPF_202603237504150010 ;
    ded:displayedBy ded:DED_Dashboard .

ded:ThermalCamera_AMH350 rdf:type owl:NamedIndividual ,
                                ded:ThermalCamera ;
    rdfs:label "熱像儀：收集 Time 與 G_High"@zh-tw ;
    ded:generatesSignal ded:ThermalGHigh_Layer1_T1 .

ded:Edge_AMH350 rdf:type owl:NamedIndividual ,
                        ded:EdgeDevice ;
    rdfs:label "Edge：收集 sample_ms、XYZ、g_high、align_error_ms"@zh-tw ;
    ded:generatesSignal ded:EdgePosition_Layer1_T1 ,
                        ded:EdgeAlignmentError_Layer1_T1 .

#################################################################
# Incoming data fields
#################################################################

ded:Field_Thermal_Time rdf:type owl:NamedIndividual ,
                              ded:JSONField ;
    rdfs:label "熱像儀欄位：Time"@zh-tw ;
    ded:hasJSONKey "Time" .

ded:Field_Thermal_GHigh rdf:type owl:NamedIndividual ,
                               ded:JSONField ;
    rdfs:label "熱像儀欄位：G_High"@zh-tw ;
    ded:hasJSONKey "G_High" .

ded:Field_Edge_SampleMS rdf:type owl:NamedIndividual ,
                               ded:JSONField ;
    rdfs:label "Edge 欄位：sample_ms"@zh-tw ;
    ded:hasJSONKey "sample_ms" .

ded:Field_Edge_X rdf:type owl:NamedIndividual ,
                        ded:JSONField ;
    rdfs:label "Edge 欄位：machine_x_mm"@zh-tw ;
    ded:hasJSONKey "machine_x_mm" .

ded:Field_Edge_Y rdf:type owl:NamedIndividual ,
                        ded:JSONField ;
    rdfs:label "Edge 欄位：machine_y_mm"@zh-tw ;
    ded:hasJSONKey "machine_y_mm" .

ded:Field_Edge_Z rdf:type owl:NamedIndividual ,
                        ded:JSONField ;
    rdfs:label "Edge 欄位：machine_z_mm"@zh-tw ;
    ded:hasJSONKey "machine_z_mm" .

ded:Field_Edge_GHigh rdf:type owl:NamedIndividual ,
                            ded:JSONField ;
    rdfs:label "Edge 欄位：g_high"@zh-tw ;
    ded:hasJSONKey "g_high" .

ded:Field_Edge_AlignmentError rdf:type owl:NamedIndividual ,
                                     ded:JSONField ;
    rdfs:label "Edge 欄位：align_error_ms"@zh-tw ;
    ded:hasJSONKey "align_error_ms" .

ded:Field_MPF_Layer rdf:type owl:NamedIndividual ,
                           ded:JSONField ;
    rdfs:label "MPF 欄位：圖層"@zh-tw ;
    ded:hasJSONKey "layer" .

ded:Field_MPF_ToolPath rdf:type owl:NamedIndividual ,
                              ded:JSONField ;
    rdfs:label "MPF 欄位：刀具路徑"@zh-tw ;
    ded:hasJSONKey "toolpath" .

ded:Field_MPF_LaserState rdf:type owl:NamedIndividual ,
                                ded:JSONField ;
    rdfs:label "MPF 欄位：雷射狀態"@zh-tw ;
    ded:hasJSONKey "laser_on" .

ded:Field_MPF_PowderState rdf:type owl:NamedIndividual ,
                                 ded:JSONField ;
    rdfs:label "MPF 欄位：送粉狀態"@zh-tw ;
    ded:hasJSONKey "powder_supply_on" .

#################################################################
# Runtime semantic graph
#################################################################

ded:MPF_202603237504150010 rdf:type owl:NamedIndividual ,
                                  ded:NCFile ;
    rdfs:label "MPF：202603237504150010_modified.MPF"@zh-tw ;
    ded:sourceFile "202603237504150010_modified.MPF" ;
    ded:containsField ded:Field_MPF_Layer ,
                      ded:Field_MPF_ToolPath ,
                      ded:Field_MPF_LaserState ,
                      ded:Field_MPF_PowderState .

ded:NCBlock_Layer1_Start rdf:type owl:NamedIndividual ,
                                ded:NCBlock ;
    rdfs:label "NC 區塊：Layer 1 起始段"@zh-tw .

ded:Segment_Layer1_Start rdf:type owl:NamedIndividual ,
                                ded:ToolPathSegment ;
    rdfs:label "路徑段：Layer 1 起始沉積段"@zh-tw .

ded:Window_Layer1_Start rdf:type owl:NamedIndividual ,
                               ded:MultiSensorWindow ;
    rdfs:label "同步視窗：Layer 1 起始區間"@zh-tw ;
    ded:hasStartTime "2026-05-25T10:32:08.219+08:00"^^xsd:dateTime ;
    ded:hasEndTime "2026-05-25T10:32:16.618+08:00"^^xsd:dateTime ;
    ded:alignedWithNCBlock ded:NCBlock_Layer1_Start ;
    ded:alignedWithToolPathSegment ded:Segment_Layer1_Start ;
    ded:usesKnowledge ded:Knowledge_TimeAlignment ,
                      ded:Rule_Good ,
                      ded:Rule_Warning ,
                      ded:Rule_Abnormal ;
    ded:evaluatedByRule ded:Rule_Good ,
                        ded:Rule_Warning ,
                        ded:Rule_Abnormal ;
    ded:hasDiagnosis ded:Diagnosis_Layer1_Good ;
    ded:displayedBy ded:DED_Dashboard .

ded:ThermalGHigh_Layer1_T1 rdf:type owl:NamedIndividual ,
                                  ded:ThermalGHighSignal ;
    rdfs:label "熱像資料：G_High = 71.90 °C"@zh-tw ;
    ded:belongsToWindow ded:Window_Layer1_Start ;
    ded:mapsToJSONField ded:Field_Thermal_Time ,
                        ded:Field_Thermal_GHigh ;
    ded:hasTimestamp "2026-05-25T10:32:08.219+08:00"^^xsd:dateTime ;
    ded:hasUnit "°C" ;
    ded:hasValue 71.90 ;
    ded:displayedBy ded:DED_Dashboard .

ded:EdgePosition_Layer1_T1 rdf:type owl:NamedIndividual ,
                                  ded:EdgePositionSignal ;
    rdfs:label "Edge 資料：XYZ 機台座標"@zh-tw ;
    ded:belongsToWindow ded:Window_Layer1_Start ;
    ded:mapsToJSONField ded:Field_Edge_SampleMS ,
                        ded:Field_Edge_X ,
                        ded:Field_Edge_Y ,
                        ded:Field_Edge_Z ,
                        ded:Field_Edge_GHigh ;
    ded:hasTimestamp "2026-05-25T10:32:08.219+08:00"^^xsd:dateTime ;
    ded:hasXMillimeter 21.87 ;
    ded:hasYMillimeter -24.98 ;
    ded:hasZMillimeter 109.982 ;
    ded:displayedBy ded:DED_Dashboard .

ded:EdgeAlignmentError_Layer1_T1 rdf:type owl:NamedIndividual ,
                                        ded:EdgeAlignmentErrorSignal ;
    rdfs:label "Edge 資料：時間對齊誤差"@zh-tw ;
    ded:belongsToWindow ded:Window_Layer1_Start ;
    ded:mapsToJSONField ded:Field_Edge_AlignmentError ;
    ded:hasTimestamp "2026-05-25T10:32:08.219+08:00"^^xsd:dateTime ;
    ded:hasUnit "ms" ;
    ded:hasValue -0.265547 ;
    ded:displayedBy ded:DED_Dashboard .

#################################################################
# Quality rules and dashboard result
#################################################################

ded:Rule_Good rdf:type owl:NamedIndividual ,
                      ded:ThresholdRule ;
    rdfs:label "品質規則：優良"@zh-tw ;
    ded:hasStateLabel "優良" ;
    ded:hasMaxExclusive 1300 ;
    ded:hasRuleExpression "G_High < 1300" .

ded:Rule_Warning rdf:type owl:NamedIndividual ,
                         ded:ThresholdRule ;
    rdfs:label "品質規則：警示"@zh-tw ;
    ded:hasStateLabel "警示" ;
    ded:hasMinInclusive 1300 ;
    ded:hasMaxExclusive 1500 ;
    ded:hasRuleExpression "1300 <= G_High < 1500" .

ded:Rule_Abnormal rdf:type owl:NamedIndividual ,
                          ded:ThresholdRule ;
    rdfs:label "品質規則：異常"@zh-tw ;
    ded:hasStateLabel "異常" ;
    ded:hasMinInclusive 1500 ;
    ded:hasRuleExpression "G_High >= 1500" .

ded:Knowledge_TimeAlignment rdf:type owl:NamedIndividual ,
                                   ded:AlignmentKnowledge ;
    rdfs:label "Knowledge：時間與路徑對齊"@zh-tw ;
    ded:hasRuleExpression "thermal.Time + edge.sample_ms + MPF toolpath -> MultiSensorWindow" .

ded:Diagnosis_Layer1_Good rdf:type owl:NamedIndividual ,
                                 ded:Diagnosis ;
    rdfs:label "品質判斷：Layer 1 優良"@zh-tw ;
    ded:displayedBy ded:DED_Dashboard .

ded:DED_Dashboard rdf:type owl:NamedIndividual ,
                          ded:Dashboard ;
    rdfs:label "DED 成型儀表板：路徑、Heatmap、熱像摘要、品質判斷"@zh-tw .
