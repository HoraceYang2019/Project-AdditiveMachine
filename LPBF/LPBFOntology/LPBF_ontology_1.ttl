                                     lpbftr:hasResponseGroup lpbftr:ThermalStressManagement ;
                                     lpbftr:hasResponseText "Rescan the layer at lower power immediately after melting to act as localized in-situ annealing and relieve stress before the next layer." ;
                                     skos:prefLabel "rescanning / in-situ annealing"@en .


