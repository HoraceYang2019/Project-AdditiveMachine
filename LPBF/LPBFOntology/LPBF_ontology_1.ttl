                               rdfs:domain lpbf:MultiSensorWindow ;
                               rdfs:range lpbftr:FailureCause ;
                               rdfs:comment "Links a runtime multi-sensor window to a possible cause inferred from troubleshooting knowledge."@en ;
                               rdfs:label "has troubleshooting cause"@en .


###  http://nkust.edu.tw/mislab/lpbf/ontology/troubleshooting#hasTroubleshootingFaultMode
lpbftr:hasTroubleshootingFaultMode rdf:type owl:ObjectProperty ;
                                   rdfs:domain lpbf:MultiSensorWindow ;
                                   rdfs:range lpbftr:FaultMode ;
                                   rdfs:comment "Links a runtime multi-sensor window to a diagnosed LPBF troubleshooting fault mode."@en ;
                                   rdfs:label "has troubleshooting fault mode"@en .


###  http://nkust.edu.tw/mislab/lpbf/ontology/troubleshooting#hasTroubleshootingResponse
lpbftr:hasTroubleshootingResponse rdf:type owl:ObjectProperty ;
                                  rdfs:domain lpbf:MultiSensorWindow ;
                                  rdfs:range lpbftr:FailureResponse ;
                                  rdfs:comment "Links a runtime multi-sensor window to a corrective action recommended by the troubleshooting chart."@en ;
                                  rdfs:label "has troubleshooting countermeasure"@en .


###  http://nkust.edu.tw/mislab/lpbf/ontology/troubleshooting#supportsProcessState
lpbftr:supportsProcessState rdf:type owl:ObjectProperty ;
                            rdfs:domain lpbftr:FaultMode ;
                            rdfs:comment "Connects a troubleshooting fault mode to the LPBF process-state concept it can support."@en ;
                            rdfs:label "supports process state"@en .


###  http://nkust.edu.tw/mislab/lpbf/ontology/troubleshooting#supportsSurfaceQuality
lpbftr:supportsSurfaceQuality rdf:type owl:ObjectProperty ;
                              rdfs:domain lpbftr:FaultMode ;
                              rdfs:range lpbf:QualityMetric ;
                              rdfs:comment "Connects a troubleshooting fault mode to the LPBF surface-quality concept it can support."@en ;
                              rdfs:label "supports surface quality"@en .


