@prefix : <http://nkust.edu.tw/mislab/lpbf/ontology/process#LPBFExtendedOntology> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix mis: <http://nkust.edu.tw/mislab#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix lpbf: <http://nkust.edu.tw/mislab/lpbf/ontology/process#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix lpbftr: <http://nkust.edu.tw/mislab/lpbf/ontology/troubleshooting#> .
@base <http://nkust.edu.tw/mislab/lpbf/ontology/process#LPBFExtendedOntology> .

<http://nkust.edu.tw/mislab/lpbf/ontology/process#LPBFExtendedOntology> rdf:type owl:Ontology ;
                                                                         owl:imports lpbftr: ;
                                                                         rdfs:comment "Extended with TEC LPBF troubleshooting knowledge: failure modes, causes, and corrective countermeasures parsed from the uploaded LPBF troubleshooting chart."@en ,
                                                                                      "Generated from uploaded image tec_lpbf_trouble_shooting_01_zh.png. Cell recommendations are based on detected black markers in the chart matrix and should be verified against the original manual before production use."@en ,
                                                                                      "Ontology for LPBF process monitoring with build job files, scan segments, sensing windows, multi-sensor alignment, diagnosis, prediction, and communication mapping."@en ;
                                                                         rdfs:label "Extended LPBF Process Monitor Ontology with Build Job File and Sensing Windows"@en ,
                                                                                    "LPBF ontology extended with LPBF troubleshooting knowledge"@en ,
                                                                                    "LPBF troubleshooting ontology parsed from TEC chart"@en ,
                                                                                    "LPBF故障对策图谱本体"@zh ;
                                                                         owl:versionInfo "0.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#related
skos:related rdf:type owl:AnnotationProperty .


