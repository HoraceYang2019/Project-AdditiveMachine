lpbftr:PowderSpatterEntanglementClogging a lpbftr:FaultMode,
        owl:NamedIndividual ;
    lpbftr:belongsToCategory lpbftr:PowderSpatterDisposal ;
    lpbftr:hasCause lpbftr:C26_PowderSpatterTooThin,
