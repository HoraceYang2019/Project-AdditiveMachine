lpbf:DiagSeq_001 a lpbf:DiagnosisSequence,
        owl:NamedIndividual ;
    lpbf:hasMachineId "TMV-720" ;
    lpbf:hasName "Diagnosis sequence for LPBF window progression" ;
    lpbf:mapsToJSONField lpbf:Field_diagnosis_sequence ;
    lpbf:mapsToMQTTTopic lpbf:Topic_DiagnosisSequence ;
    lpbf:mapsToOPCUANode lpbf:OPCUA_DiagnosisSequence .

