lpbftr:EdgeDefectAndLocalDamage a lpbftr:FailureCategory,
        owl:NamedIndividual ;
    skos:altLabel "Edge defects and local damage"@en ;
    skos:prefLabel "毛刺及崩碎"@zh ;
    skos:related lpbf:QualityMetric .

lpbftr:R22_OverhangOrMachineClearanceReduce a lpbftr:FailureResponse,
        owl:NamedIndividual ;
    lpbftr:hasCountermeasureGroup lpbftr:MachineSetup ;
    lpbftr:sourceColumnIndex 22 ;
    skos:altLabel "Reduce overhang and drive/machine clearance"@en ;
    skos:prefLabel "减小悬伸量；减小动力、机床间隙"@zh .

lpbftr:TEC_LPBFTroubleshootingChart a lpbftr:TroubleshootingChart,
        owl:NamedIndividual ;
    rdfs:label "TEC LPBF troubleshooting chart"@en,
        "TECLPBF故障对策表"@zh ;
    lpbftr:hasFaultMode lpbftr:FlatnessParallelismDeterioration,
        lpbftr:LargeSurfaceRoughness,
        lpbftr:PowderSpatterEntanglementClogging ;
    dc:creator "hao" ;
    dc:date "2026-05-31T00:00:00+00:00"^^xsd:dateTime ;
    rdfs:comment "LPBF troubleshooting knowledge parsed from the uploaded TEC chart and integrated into the LPBF ontology. Verify cell-level recommendations against the original chart before production deployment."@en ;
    rdfs:seeAlso "tec_lpbf_trouble_shooting_01_zh.png" .

lpbftr:belongsToCategory a owl:ObjectProperty ;
    rdfs:domain lpbftr:FaultMode ;
    rdfs:range lpbftr:FailureCategory .

lpbftr:hasCause a owl:ObjectProperty ;
    rdfs:domain lpbftr:FaultMode ;
    rdfs:range lpbftr:FailureCause .

lpbftr:hasCountermeasureGroup a owl:ObjectProperty ;
    rdfs:domain lpbftr:FailureResponse ;
    rdfs:range lpbftr:ResponseGroup .

lpbftr:hasFaultMode a owl:ObjectProperty ;
    rdfs:domain lpbftr:TroubleshootingChart ;
    rdfs:range lpbftr:FaultMode .

lpbftr:hasRecommendedCountermeasure a owl:ObjectProperty ;
    rdfs:domain lpbftr:FailureCause ;
    rdfs:range lpbftr:FailureResponse .

lpbftr:hasTroubleshootingCause a owl:ObjectProperty ;
    rdfs:label "has troubleshooting cause"@en ;
    rdfs:comment "Links a runtime multi-sensor window to a possible cause inferred from troubleshooting knowledge."@en ;
    rdfs:domain lpbf:MultiSensorWindow ;
    rdfs:range lpbftr:FailureCause .

lpbftr:hasTroubleshootingCountermeasure a owl:ObjectProperty ;
    rdfs:label "has troubleshooting countermeasure"@en ;
    rdfs:comment "Links a runtime multi-sensor window to a corrective action recommended by the troubleshooting chart."@en ;
    rdfs:domain lpbf:MultiSensorWindow ;
    rdfs:range lpbftr:FailureResponse .

lpbftr:hasTroubleshootingFaultMode a owl:ObjectProperty ;
    rdfs:label "has troubleshooting fault mode"@en ;
    rdfs:comment "Links a runtime multi-sensor window to a diagnosed LPBF troubleshooting fault mode."@en ;
    rdfs:domain lpbf:MultiSensorWindow ;
    rdfs:range lpbftr:FaultMode .

lpbftr:sourceCellMarkerCount a owl:DatatypeProperty ;
    rdfs:domain lpbftr:FailureCause ;
    rdfs:range xsd:integer .

lpbftr:sourceColumnIndex a owl:DatatypeProperty ;
    rdfs:domain lpbftr:FailureResponse ;
    rdfs:range xsd:integer .

lpbftr:sourceRowIndex a owl:DatatypeProperty ;
    rdfs:domain lpbftr:FailureCause ;
    rdfs:range xsd:integer .

lpbftr:supportsProcessState a owl:ObjectProperty ;
    rdfs:label "supports process state"@en ;
    rdfs:comment "Connects a troubleshooting fault mode to the LPBF process-state concept it can support."@en ;
    rdfs:domain lpbftr:FaultMode ;
    rdfs:range lpbf:ProcessState .

lpbftr:supportsSurfaceQuality a owl:ObjectProperty ;
    rdfs:label "supports surface quality"@en ;
    rdfs:comment "Connects a troubleshooting fault mode to the LPBF surface-quality concept it can support."@en ;
    rdfs:domain lpbftr:FaultMode ;
    rdfs:range lpbf:QualityMetric .

dc:creator a owl:AnnotationProperty .

dc:date a owl:AnnotationProperty .

skos:altLabel a owl:AnnotationProperty .

skos:prefLabel a owl:AnnotationProperty .

skos:related a owl:AnnotationProperty .

