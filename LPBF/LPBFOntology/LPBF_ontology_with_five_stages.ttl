mis:Stage02_Identification a mis:IdentificationStage,
        owl:NamedIndividual ;
    rdfs:label "Stage 02 - Identification"@en ;
    mis:consumesData mis:AcousticEmission,
        mis:BuildPlatformPosition,
        mis:ChamberOxygen,
        mis:CoaxialMeltPoolVision,
        mis:DerivedCoolingRateFeature,
        mis:DerivedMeltPoolGeometryFeature,
        mis:DerivedThermalGradientFeature,
        mis:GalvoPosition,
        mis:LaserCurrent,
        mis:LaserPower,
        mis:PowderBedVision,
        mis:Pyrometer,
        mis:RecoaterSignal_01,
        mis:ScanSpeed,
        mis:ThermalCamera ;
    mis:hasStageOrder 2 ;
    mis:identifiesState mis:BallingDefect,
        mis:MeltPoolFluctuating,
        mis:MeltPoolLarge,
        mis:MeltPoolSmall,
        mis:MeltPoolStable,
        mis:NoDefect,
        mis:PorosityDefect,
        mis:PowderShortage,
        mis:PowderUniform,
        mis:ProcessKeyhole,
        mis:ProcessLackOfFusion,
        mis:ProcessNormal,
        mis:ProcessOverheating,
        mis:ProcessUnstable,
        mis:RecoaterStreak,
        mis:SpatterDefect ;
    mis:nextStage mis:Stage03_Inference ;
    mis:producesData mis:BallingDefect,
        mis:MeltPoolFluctuating,
        mis:MeltPoolLarge,
        mis:MeltPoolSmall,
        mis:MeltPoolStable,
        mis:NoDefect,
        mis:PorosityDefect,
        mis:PowderShortage,
        mis:PowderUniform,
        mis:ProcessKeyhole,
        mis:ProcessLackOfFusion,
        mis:ProcessNormal,
        mis:ProcessOverheating,
        mis:ProcessUnstable,
        mis:RecoaterStreak,
        mis:SpatterDefect .

mis:Stage03_Inference a mis:InferenceStage,
        owl:NamedIndividual ;
    rdfs:label "Stage 03 - Inference"@en ;
    mis:consumesData mis:BallingDefect,
        mis:MeltPoolFluctuating,
        mis:MeltPoolLarge,
        mis:MeltPoolSmall,
        mis:MeltPoolStable,
        mis:NoDefect,
        mis:PorosityDefect,
        mis:PowderShortage,
        mis:PowderUniform,
        mis:ProcessKeyhole,
        mis:ProcessLackOfFusion,
        mis:ProcessNormal,
        mis:ProcessOverheating,
        mis:ProcessUnstable,
        mis:RecoaterStreak,
        mis:SpatterDefect ;
    mis:hasStageOrder 3 ;
    mis:infersQualityAcceptance mis:QualityAccepted,
        mis:QualityMargin,
        mis:QualityReject ;
    mis:nextStage mis:Stage04_Evaluation ;
    mis:producesData mis:InferredLPBFCauseSet,
        mis:InferredLPBFResponseSet,
        mis:QualityAccepted,
        mis:QualityMargin,
        mis:QualityReject .

mis:Stage04_Evaluation a mis:EvaluationStage,
        owl:NamedIndividual ;
    rdfs:label "Stage 04 - Evaluation"@en ;
    mis:consumesData mis:InferredLPBFCauseSet,
        mis:InferredLPBFResponseSet,
        mis:QualityAccepted,
        mis:QualityMargin,
        mis:QualityReject ;
    mis:evaluatesResult mis:DefectRiskEvaluationResult,
        mis:LayerQualityEvaluationResult,
        mis:MeltPoolEvaluationResult,
        mis:PartQualityEvaluationResult,
        mis:ThermalFieldEvaluationResult ;
    mis:hasStageOrder 4 ;
    mis:nextStage mis:Stage05_Adaption ;
    mis:producesData mis:DefectRiskEvaluationResult,
        mis:LayerQualityEvaluationResult,
        mis:MeltPoolEvaluationResult,
        mis:PartQualityEvaluationResult,
        mis:ThermalFieldEvaluationResult .

mis:Stage05_Adaption a mis:AdaptionStage,
        owl:NamedIndividual ;
    rdfs:label "Stage 05 - Adaptation"@en,
        "Stage 05 - Adaption"@en ;
    mis:consumesData mis:DefectRiskEvaluationResult,
        mis:LayerQualityEvaluationResult,
        mis:MeltPoolEvaluationResult,
        mis:PartQualityEvaluationResult,
        mis:ThermalFieldEvaluationResult ;
    mis:hasStageOrder 5 ;
    mis:suggestsAction mis:BuildManagementSuggestion,
        mis:BuildPauseOrAbortSuggestion,
        mis:LaserPowerAdjustmentSuggestion,
        mis:LayerRescanSuggestion,
        mis:RecoatingInterventionSuggestion,
        mis:ScanSpeedAdjustmentSuggestion,
        mis:ScanStrategyUpdateSuggestion,
        mis:UpdatedBuildJobSuggestion .

