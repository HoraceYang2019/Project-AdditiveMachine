lpbftr:C26_PowderSpatterTooThin a lpbftr:FailureCause,
        owl:NamedIndividual ;
    lpbftr:sourceRowIndex 26 ;
    rdfs:comment "Parsed from row 26 under fault mode PowderSpatterEntanglementClogging."@en ;
    skos:altLabel "PowderSpatter too thin"@en ;
    skos:prefLabel "切屑太薄"@zh .

lpbftr:C28_PoorPowderSpatterEvacuation a lpbftr:FailureCause,
        owl:NamedIndividual ;
    lpbftr:sourceRowIndex 28 ;
